{
    "name": "researcher86/architecture-decision-lab",
    "type": "project",
    "license": "MIT",
    "description": "A measured laboratory of monoliths, services, storage, messaging and consistency decisions.",
    "autoload": {
        "psr-4": {
            "ArchitectureDecisionLab\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ArchitectureDecisionLab\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "rm -rf /tmp/phpstan && phpstan analyse --memory-limit=1G",
        "format": "php-cs-fixer fix --diff",
        "format:check": "php-cs-fixer fix --diff --dry-run"
    },
    "config": {
        "sort-packages": true
    }
}
